{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coding-Baby-Penguin/optimal-challenge-plugin/config/allocation-ledger.schema.json",
  "title": "Optimal Challenge allocation ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_version", "transaction_version", "reconciliation_version", "transaction_id", "status", "balances_known", "unit", "ceiling", "measurement", "enforcement", "measurement_source", "reserves", "available", "reserved", "funded_consumed", "funded_reservation_overrun", "unfunded_consumed", "total_consumed", "released", "reservations", "history", "reconciliation_history", "reset_history", "applied_event_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_version": {"type": "integer", "minimum": 0},
    "transaction_version": {"type": "integer", "minimum": 0},
    "reconciliation_version": {"type": "integer", "minimum": 0},
    "transaction_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "degraded", "blocked"]},
    "balances_known": {"type": "boolean"},
    "unit": {"enum": ["credits", "tokens", "seconds", "currency", "tool_calls", "model_calls"]},
    "ceiling": {"type": "number", "minimum": 0},
    "measurement": {"enum": ["unavailable", "estimated", "observed"]},
    "enforcement": {"enum": ["advisory", "local_enforced", "provider_enforced"]},
    "measurement_source": {"type": ["string", "null"], "minLength": 1},
    "reserves": {"$ref": "#/$defs/reserves"},
    "available": {"$ref": "#/$defs/balance"},
    "reserved": {"$ref": "#/$defs/balance"},
    "funded_consumed": {"$ref": "#/$defs/balance"},
    "funded_reservation_overrun": {"$ref": "#/$defs/balance"},
    "unfunded_consumed": {"$ref": "#/$defs/balance"},
    "total_consumed": {"$ref": "#/$defs/balance"},
    "released": {"$ref": "#/$defs/balance"},
    "reservations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/reservation"}},
    "history": {"type": "array", "items": {"$ref": "#/$defs/history"}},
    "reconciliation_history": {"type": "array", "items": {"$ref": "#/$defs/history"}},
    "reset_history": {"type": "array", "items": {"$ref": "#/$defs/reset"}},
    "applied_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recovery_required": {"type": "boolean"},
    "recovery_error": {"type": "string", "minLength": 1},
    "accuracy_marker": {"enum": ["advisory_reset", "unknown_recovery"]},
    "quarantine": {"type": "array", "items": {"$ref": "#/$defs/quarantine"}}
  },
  "$defs": {
    "balance": {"type": ["number", "null"], "minimum": 0},
    "reserves": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinator", "integration", "mandatory_review"],
      "properties": {"coordinator": {"type": "number", "minimum": 0}, "integration": {"type": "number", "minimum": 0}, "mandatory_review": {"type": "number", "minimum": 0}}
    },
    "reservation": {
      "type": "object", "additionalProperties": false,
      "required": ["reservation_id", "assignment_id", "kind", "attempt", "initial_reserved", "active_reserved", "funded_consumed", "funded_reservation_overrun", "unfunded_consumed", "released_unused", "state", "measurement", "reservation_transaction_id", "evidence_refs", "terminal_evidence"],
      "properties": {
        "reservation_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "logical_teammate_id": {"type": ["string", "null"], "minLength": 1},
        "kind": {"enum": ["coordinator", "worker", "tool", "retry", "review", "integration"]},
        "attempt": {"type": "integer", "minimum": 1},
        "initial_reserved": {"type": "number", "minimum": 0},
        "active_reserved": {"type": "number", "minimum": 0},
        "funded_consumed": {"type": "number", "minimum": 0},
        "funded_reservation_overrun": {"type": "number", "minimum": 0},
        "unfunded_consumed": {"type": "number", "minimum": 0},
        "released_unused": {"type": "number", "minimum": 0},
        "state": {"enum": ["reserved", "running", "complete", "failed", "cancelled", "unknown"]},
        "measurement": {"enum": ["unavailable", "estimated", "observed"]},
        "reservation_transaction_id": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terminal_evidence": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "type", "transaction_id", "transaction_version", "event_hash"],
      "properties": {"event_id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "transaction_id": {"type": "string", "minLength": 1}, "transaction_version": {"type": "integer", "minimum": 0}, "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reservation_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
    },
    "reset": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "transaction_id", "reason", "authority", "evidence_ref", "prior"],
      "properties": {"event_id": {"type": "string", "minLength": 1}, "transaction_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "authority": {"enum": ["user", "coordinator"]}, "evidence_ref": {"type": "string", "minLength": 1}, "prior": {"$ref": "#/$defs/reservation"}}
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "source"],
      "properties": {"reason": {"type": "string", "minLength": 1}, "source": {"enum": ["registry", "ledger", "cross-record"]}}
    }
  }
}
